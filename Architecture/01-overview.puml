@startuml
title Goose Patrol - 1. Game World Overview

skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

' classes
class Main {
    - state: GameState
    - timeRemaining : float
    - started : boolean
    - ctx : GameContext
    + create() : void
    + render() : void
    - togglePause() : void
    - resetGame() : void
}

class GameContext {
    + player: Player
    + inventory : Inventory
    + geese : List<Goose>
    - itemsUsed : int
    - eventsInteracted : int
    - gooseSpeedMultiplier : float
    + recordItemUsed() : void
    + recordEvent() : void
    + resetStats() : void
    + setWorldSize (width : float, height : float) : void
}

class Player {
    - x : float
    - y : float
    - moving : boolean
    + update(delta : float, collisionManager : CollisionManager) : void
    + draw(batch : SpriteBatch) : void
    + reset(startX : float, startY : float) : void
}

class Inventory {
    - selectedSlot : int
    + handleItemUseInput() : String
    + useSelectedItem() : String
    + hasShield() : boolean
    + consumeShield() : void
}

class Goose {
    - state : GooseState
    - movementType : MovementType
    + update(delta : float, width : float, height : float) : void
    + draw(batch : SpriteBatch) : void
    + disperse() : void
}

class CollisionManager {
    - treeObstacles : List<Rectangle>
    + canPlayerOccupy(x : float, y : float, radius : float) : boolean
    + movePlayer(...) : Vector2
    + checkGooseCollisions(ctx : GameContext) : GooseCollisionResult
}

class GameRenderer {
    - ctx : GameContext
    + render() : void
}

class HUD {
    + drawStats(timeRemaining : float, itemsUsed : int, eventsInteracted : int, statusLines : List<String>) : void
    + drawScreen(state : GameState, started : boolean) : void
    + drawHotbar(inventory : Inventory) : void
}

enum GameState {
  PAUSED
  RUNNING
  INSTRUCTIONS
  WON
  LOST
}

' relationships
Main --> GameContext : coordinates
Main --> CollisionManager : uses
Main --> GameRenderer : renders through
Main --> HUD : displays through
Main --> GameState : tracks

GameContext --> Player : holds
GameContext --> Inventory : holds
GameContext --> "0..*" Goose : tracks

Player ..> CollisionManager : movement collision
GameRenderer ..> GameContext : draws entities
HUD ..> Inventory : hotbar

@enduml
