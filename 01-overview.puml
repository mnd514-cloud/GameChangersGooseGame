@startuml 01-overview
title Goose Patrol - 1. Overview (screens, world, parts the world owns)

' ---- display settings: leave as they are ----
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

' ---- classes ----
class GooseGame <<extends libGDX Game>> {
  + create()
  + setScreen(s)
}

interface Screen {
  + show()
  + render(delta)
  + pause()
  + resume()
}

class MenuScreen {
  + onPlay()
}

class GameScreen {
  + render(delta)
  + togglePause()
}

class EndScreen {
  - outcome
  - finalScore
}

class GameWorld {
  - state : GameState
  + update(delta)
  + pause()
  + resume()
  + checkEndState()
}

' name-only boxes: members are on diagram 2, 3 or 4
class HUD
class InputHandler
class Player
class Goose
class GameMap
class PickupItem
abstract class HiddenEvent
class GameTimer
class ScoreTracker

' ---- relationships ----
' arrow = association, *-- = composition (owner has the *), <|.. = implements
GooseGame --> "1..*" Screen : screens
Screen <|.. MenuScreen
Screen <|.. GameScreen
Screen <|.. EndScreen

GameScreen *-- "1" GameWorld : world
GameScreen --> HUD : hud
GameScreen --> InputHandler : input

GameWorld *-- "1" Player
GameWorld *-- "0..*" Goose
GameWorld *-- "1" GameMap
GameWorld *-- "0..*" PickupItem
GameWorld *-- "5..*" HiddenEvent
GameWorld *-- "1" GameTimer
GameWorld *-- "1" ScoreTracker

@enduml
